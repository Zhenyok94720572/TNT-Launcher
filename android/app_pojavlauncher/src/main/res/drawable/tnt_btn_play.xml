<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#3A3A3A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/tnt_green_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#4CBB5A" android:endColor="@color/tnt_green_dark" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#5FD06C" />
        </shape>
    </item>
</selector>
