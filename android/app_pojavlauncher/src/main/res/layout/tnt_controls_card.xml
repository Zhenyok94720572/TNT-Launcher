<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/tnt_card"
    android:padding="12dp">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tnt_builds"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tnt_download_build"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tnt_btn_dark"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/tnt_download_build"
                android:textColor="@color/tnt_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tnt_version"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tnt_version"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tnt_field"
                android:drawableEnd="@drawable/spinner_arrow"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="@string/tnt_loading"
                android:textColor="@color/primary_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/tnt_isolation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/tnt_isolation"
        android:textColor="@color/primary_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tnt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/secondary_text"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/tnt_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tnt_accent"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tnt_more"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/tnt_btn_dark"
            android:contentDescription="@string/tnt_more"
            android:src="@drawable/tnt_ic_more" />

        <Button
            android:id="@+id/tnt_mods"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/tnt_btn_dark"
            android:text="@string/tnt_mods_button"
            android:textColor="@color/tnt_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:layout_marginStart="8dp"
            android:background="@drawable/tnt_btn_play"
            android:text="@string/tnt_play"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
