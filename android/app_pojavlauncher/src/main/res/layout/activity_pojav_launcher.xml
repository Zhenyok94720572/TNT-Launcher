<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tnt_background">

    <!-- Верхняя панель TNT: логотип, название, аккаунт, настройки -->
    <View
        android:id="@+id/tnt_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/background_status_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/tnt_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/tnt_logo"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/tnt_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/tnt_top_bar"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tnt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="TNT"
        android:textColor="@color/tnt_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="@id/tnt_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/tnt_top_bar"
        app:layout_constraintStart_toEndOf="@id/tnt_logo" />

    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:dropDownWidth="260dp"
        android:dropDownVerticalOffset="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tnt_title"
        app:layout_constraintEnd_toStartOf="@id/setting_button" />

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_settings"
        android:scaleType="centerInside"
        android:padding="14dp"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/tnt_top_bar" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
