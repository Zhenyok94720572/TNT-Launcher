<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/tnt_mod_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tnt_field"
            android:gravity="center"
            android:textColor="@color/tnt_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tnt_mod_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tnt_mod_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tnt_mod_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/tnt_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tnt_mod_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/tnt_mod_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="104dp"
        android:background="@drawable/tnt_btn_play"
        android:focusable="false"
        android:paddingHorizontal="10dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
